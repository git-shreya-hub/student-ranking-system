# PostgreSQL connection used by the Flask backend.
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
# run.bat creates backend/.env for you on first run by asking for your password.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/student_ranking

# Set to 1 to enable Flask debug mode (auto-reload). Leave 0 for the demo.
FLASK_DEBUG=0
PORT=5000
